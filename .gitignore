# Magento/Adobe Commerce (Composer install).
# Everything else under src/ is either installed by Composer (vendor/),
# copied from magento/magento2-base and magento2-ee-base on every
# `composer install` (bin/, dev/, lib/, pub/, setup/, app/etc/di.xml, ...),
# generated at runtime (generated/, var/, pub/static/, pub/media/),
# or local/secret (app/etc/env.php, auth.json). Track only project code/config.
/src/*
!/src/composer.json
!/src/composer.lock
!/src/patches/

!/src/app/
/src/app/*
!/src/app/code/
!/src/app/i18n/
!/src/app/design/
/src/app/design/*/Magento/
!/src/app/etc/
/src/app/etc/*
!/src/app/etc/config.php

# TLS private keys and local CA
/docker/nginx/certs/
/docker/nginx/ca/

# Local environment (copy from .env.example)
/.env
docker-compose.override.yml

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
